{
  "name": "github-code-search",
  "version": "2.0.0",
  "description": "Interactive GitHub code search with per-repo aggregation",
  "keywords": [
    "bun",
    "cli",
    "code-search",
    "developer-tools",
    "github",
    "github-api",
    "interactive",
    "json",
    "markdown",
    "organisation",
    "organization",
    "repositories",
    "search",
    "terminal",
    "tui",
    "typescript"
  ],
  "homepage": "https://fulll.github.io/github-code-search/",
  "bugs": {
    "url": "https://github.com/fulll/github-code-search/issues"
  },
  "license": "MIT",
  "author": "fulll",
  "repository": {
    "type": "git",
    "url": "https://github.com/fulll/github-code-search.git"
  },
  "bin": {
    "github-code-search": "./github-code-search.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "test:bats": "bats install.test.bats",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "typecheck": "bun check",
    "lint": "bun run typecheck",
    "knip": "knip",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:build:a11y": "VITEPRESS_HOSTNAME=http://localhost:4173 vitepress build docs",
    "docs:build:og": "bun scripts/generate-og.ts",
    "generate-ico": "bun scripts/generate-ico.ts",
    "docs:preview": "vitepress preview docs",
    "docs:a11y": "bun scripts/a11y.ts",
    "docs:lhci": "lhci autorun --config .lhci.config.cjs",
    "docs:test:responsive": "playwright test responsive.pw.ts",
    "docs:test:a11y": "playwright test a11y.pw.ts"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "bun-types": "^1.4.4",
    "knip": "^6.43.0",
    "mermaid": "^12.2.0",
    "sharp": "^0.35.5",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.2.3"
  }
}
